// Copia este fichero como credenciales.h (en esta misma carpeta) y pon el
// nombre y la clave de tus WiFi. credenciales.h no se sube a GitHub.
// Se prueban en orden; si no conecta a ninguna, el ESP32 crea su red propia.
// El ESP32 solo se conecta a redes de 2,4 GHz.

// 1. Primera red que se prueba
#define WIFI_ROUTER_SSID       "NOMBRE_DE_TU_WIFI"
#define WIFI_ROUTER_PASSWORD   "CLAVE_DE_TU_WIFI"

// 2. Segunda red (opcional: si no la necesitas, borra estas dos lineas)
#define WIFI_ROUTER2_SSID      "NOMBRE_DE_OTRA_WIFI"
#define WIFI_ROUTER2_PASSWORD  "CLAVE_DE_OTRA_WIFI"
